#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "vium"
require "irb"

if ENV["ALCHEMY_API_KEY"]
  Vium.configure do |c|
    c.connector = Vium::Connectors::Alchemy.new(api_key: ENV["ALCHEMY_API_KEY"])
    c.chain = ENV.fetch("VIUM_CHAIN", "base").to_sym
  end
  puts "Vium configured for #{Vium.config.chain.name} via Alchemy"
else
  puts "Set ALCHEMY_API_KEY to get a configured client (Vium.client)"
end

IRB.start(__FILE__)
