#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "block_given"
require "irb"

if ENV["ALCHEMY_API_KEY"]
  BlockGiven.configure do |c|
    c.connector = BlockGiven::Connectors::Alchemy.new(api_key: ENV["ALCHEMY_API_KEY"])
    c.chain = ENV.fetch("BLOCK_GIVEN_CHAIN", "base").to_sym
    c.abi_path = ENV["BLOCK_GIVEN_ABI_PATH"] if ENV["BLOCK_GIVEN_ABI_PATH"]
  end
  puts "BlockGiven configured for #{BlockGiven.config.chain.name} via Alchemy"
else
  puts "Set ALCHEMY_API_KEY to get a configured client (BlockGiven.client)"
end

IRB.start(__FILE__)
