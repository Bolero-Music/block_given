#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "uncle_block_given"
require "irb"

if ENV["ALCHEMY_API_KEY"]
  UncleBlockGiven.configure do |c|
    c.connector = UncleBlockGiven::Connectors::Alchemy.new(api_key: ENV["ALCHEMY_API_KEY"])
    c.chain = ENV.fetch("UNCLE_BLOCK_GIVEN_CHAIN", "base").to_sym
    c.abi_path = ENV["UNCLE_BLOCK_GIVEN_ABI_PATH"] if ENV["UNCLE_BLOCK_GIVEN_ABI_PATH"]
  end
  puts "UncleBlockGiven configured for #{UncleBlockGiven.config.chain.name} via Alchemy"
else
  puts "Set ALCHEMY_API_KEY to get a configured client (UncleBlockGiven.client)"
end

IRB.start(__FILE__)
